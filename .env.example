# TEMPLATE ONLY - copy to .env and put your keys THERE. This file is committed to GitHub: no real keys here.

# ---- LLM providers -------------------------------------------------------
# openai = paid | gemini = FREE (https://aistudio.google.com/apikey)
# groq   = FREE (https://console.groq.com/keys), small token limits | xai = Grok (paid)
#
# One provider for everything:
RDI_PROVIDER=gemini
#
# Or split by role (overrides RDI_PROVIDER):
#   smart = Planner, Orchestrator, Writer, Critic (big prompts)  -> Gemini recommended
#   fast  = 3 specialists, chat assistant, scope classifier       -> Groq works well here
# RDI_PROVIDER_SMART=gemini
# RDI_PROVIDER_FAST=groq

GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Optional: override model names (defaults per provider in src/rdi/config.py).
# If a provider says "model not found", put a model name from its console here.
RDI_MODEL_SMART=
RDI_MODEL_FAST=

# ---- Search backend ------------------------------------------------------
# "local" = offline fictional corpus in data/corpus.json (deterministic, best for the demo)
# "tavily" = real web search (needs TAVILY_API_KEY)
RDI_SEARCH_BACKEND=local
TAVILY_API_KEY=

RDI_MAX_CRITIC_ITERATIONS=3
RDI_CRITIC_PASS_SCORE=8
# Leave empty to use the provider default (1 on free tiers)
RDI_MAX_PARALLEL=
