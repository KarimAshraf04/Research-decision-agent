# Copy to .env and fill in. NEVER commit .env.
OPENAI_API_KEY=sk-...

# Models (change if your course uses different ones)
RDI_MODEL_FAST=gpt-4.1-mini
RDI_MODEL_SMART=gpt-4.1

# "local" = offline fictional corpus in data/corpus.json (deterministic, best for the demo)
# "tavily" = real web search (needs TAVILY_API_KEY)
RDI_SEARCH_BACKEND=local
TAVILY_API_KEY=

RDI_MAX_CRITIC_ITERATIONS=3
RDI_CRITIC_PASS_SCORE=8
RDI_MAX_PARALLEL=4
