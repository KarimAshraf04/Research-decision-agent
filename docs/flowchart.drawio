y relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e45" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n23" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n46" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="1250" width="120" height="20" as="geometry"/></mxCell><mxCell id="n47" value="LLM agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1270" width="120" height="24" as="geometry"/></mxCell><mxCell id="n48" value="Python (deterministic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#042f2e;arcSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1300" width="120" height="24" as="geometry"/></mxCell><mxCell id="n49" value="Guardrail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#451a03;arcSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="1330" width="120" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2_Specialist_tools" name="2 Specialist tools"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="420" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Inside one specialist: tool chain" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1e1b4b;" vertex="1" parent="1"><mxGeometry x="100" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;search_web&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;(query, max_results)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#042f2e;arcSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="170" height="60" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;scrape_page&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;(url)&lt;br&gt;URL policy: no localhost / metadata IP&lt;br&gt;retry flaky pages · sanitise injection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#042f2e;arcSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="80" width="230" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;extract_claims&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;(url, focus)&lt;br&gt;VERBATIM sentences (Python)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#042f2e;arcSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="85" width="190" height="70" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;save_evidence&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;(url, claim, quote)&lt;br&gt;rejects non-verbatim quotes&lt;br&gt;→ id E1, E2 …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#042f2e;arcSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="80" width="200" height="80" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;SpecialistFindings&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Pydantic structured output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="230" width="200" height="60" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;tool_failure logged&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;dead link → next source&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#450a0a;arcSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="230" width="230" height="56" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Specialist agent (LLM)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;chooses queries and sources;&lt;br&gt;cannot invent evidence ids&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="170" height="70" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="dead link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;dashed=1;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n9" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n16" value="Only save_evidence creates evidence ids, and only for quotes found word for word in a page fetched in this run. The output guardrail then blocks any report that cites an unknown id (e.g. E99)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="900" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3_Model_fallback" name="3 Model fallback"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="400" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Automatic model fallback (providers.FallbackModel)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1e1b4b;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Agent call&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#1e1b4b;strokeColor=#1e1b4b;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="130" height="44" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;gemini-3.8-flash&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="97" width="160" height="50" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;gemini-3.6-flash&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="97" width="160" height="50" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;gemini-3.5-flash-lite&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="1"><mxGeometry x="590" y="97" width="160" height="50" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;gemini-3.1-flash-lite&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="97" width="160" height="50" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;response&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#052e16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="230" width="140" height="44" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;error → safe_run retry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;waits 20 s × attempt on 429&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#450a0a;arcSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="220" width="190" height="60" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;exitX=0.5;exitY=1;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;exitX=0.5;exitY=1;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;exitX=0.5;exitY=1;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;exitX=0.5;exitY=1;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;exitX=0.75;exitY=1;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="&lt;b&gt;Cooldowns after a failure:&lt;/b&gt; quota 10 min · rate limit / outage 60 s · not found / auth / incapable 1 h. A model on cooldown is skipped. Each switch is logged as a &lt;i&gt;fallback&lt;/i&gt; event on the run timeline.&lt;br&gt;&lt;b&gt;.env:&lt;/b&gt; RDI_MODEL_SMART=gemini-4-argon puts argon first · RDI_FALLBACK_MODELS=… overrides the list · RDI_FALLBACK_MODELS=none disables fallback." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="310" width="940" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>