<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="1_Pipeline" name="1 Pipeline"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="1380" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Research &amp;amp; Decision Intelligence Agent: Pipeline" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1e1b4b;" vertex="1" parent="1"><mxGeometry x="140" y="10" width="680" height="30" as="geometry"/></mxCell><mxCell id="n3" value="&lt;i&gt;The LLM decides what to do. Python decides what is allowed.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1e1b4b;" vertex="1" parent="1"><mxGeometry x="140" y="38" width="680" height="20" as="geometry"/></mxCell><mxCell id="n4" value="User decision question" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#1e1b4b;strokeColor=#1e1b4b;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="200" height="40" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Input guardrails&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;regex: injection · secrets · size + LLM scope check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#451a03;arcSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="340" height="60" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;⛔ Blocked&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#450a0a;arcSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="157" width="160" height="46" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;① Research Planner (LLM)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;→ ResearchPlan: sub-questions, impact level&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px' color='#64748b'&gt;prompt chaining&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="240" width="340" height="66" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;② Router (Python)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;decide_path() · route_subquestions() · adds SQ-RISK&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px' color='#64748b'&gt;routing&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#042f2e;arcSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="336" width="340" height="66" as="geometry"/></mxCell><mxCell id="n9" value="③ Parallel research&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px'&gt;parallelization · asyncio.gather + semaphore&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;verticalAlign=top;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="170" y="432" width="620" height="130" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Technical&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;specialist&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="n9"><mxGeometry x="30" y="50" width="170" height="60" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Market&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;specialist&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="n9"><mxGeometry x="225" y="50" width="170" height="60" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Risk&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;specialist&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="n9"><mxGeometry x="420" y="50" width="170" height="60" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;tools per specialist:&lt;/b&gt;&lt;br&gt;search_web →&lt;br&gt;scrape_page →&lt;br&gt;extract_claims →&lt;br&gt;save_evidence (verbatim)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="800" y="440" width="150" height="90" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Output guardrail&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;on findings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#451a03;arcSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="586" width="200" height="44" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;④ Research Orchestrator (LLM)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;fills gaps / resolves conflicts via delegate_* (max 3, enforced in code)&lt;/font&gt;&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px' color='#64748b'&gt;orchestrator-workers&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="656" width="380" height="66" as="geometry"/></mxCell><mxCell id="n16" value="⑤ Evaluator-optimizer loop&lt;br&gt;&lt;i&gt;&lt;font style='font-size:10px'&gt;max 3 rounds (2 on quick path) · stop on no progress · best draft kept&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;dashed=1;verticalAlign=top;fontStyle=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="170" y="756" width="620" height="230" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Report Writer (LLM)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;→ DecisionReport&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="n16"><mxGeometry x="60" y="90" width="170" height="56" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Output guardrail&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;unknown evidence ids · injected text&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#451a03;arcSize=12;" vertex="1" parent="n16"><mxGeometry x="330" y="56" width="260" height="48" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Validator&lt;/b&gt; (Python) · unsupported numbers, missing citations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#042f2e;arcSize=12;" vertex="1" parent="n16"><mxGeometry x="330" y="118" width="260" height="40" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Critic (LLM)&lt;/b&gt; → score + issues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4338ca;fontColor=#1e1b4b;arcSize=12;" vertex="1" parent="n16"><mxGeometry x="330" y="172" width="260" height="42" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;⑥ HITL gate (Python)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;high impact? sensitive?&lt;br&gt;open issues? low confidence?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#042f2e;" vertex="1" parent="1"><mxGeometry x="420" y="1016" width="300" height="120" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Approval queue&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;SQLite · Approvals tab&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#042f2e;" vertex="1" parent="1"><mxGeometry x="190" y="1170" width="180" height="70" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Human reviewer&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontColor=#042f2e;" vertex="1" parent="1"><mxGeometry x="420" y="1170" width="150" height="70" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;✅ publish_report&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;outputs/&amp;lt;run_id&amp;gt;.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#052e16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="1180" width="180" height="50" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;✕ Not published&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#450a0a;arcSize=12;" vertex="1" parent="1"><mxGeometry x="425" y="1280" width="140" height="40" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="blocked" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="ok" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e30" value="full" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;fontColor=#475569;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relativ